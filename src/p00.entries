0x5BA5   # 0xC000: call 0xC010 / call 0xC03C / call 0xC024 y devuelve el gancho H.KEYI
0x5BB5   # 0xC010: pone en las paginas 1 y 2 el slot de 0xF0F4 (0xC030) y los bancos 7-8-9 de ESE cartucho
0x5BC9   # 0xC024: vuelve al slot de 0xF0F6, banco 0 en 0x5000 y 7-8-9
0x5BD5   # 0xC030: ENASLT (0x0024) con H = 0x40 y H = 0x80
0x5BE1   # 0xC03C: copia a 0xC100 los 20 trozos de la tabla 0xC059 (= p00:5BFE)
