# Puntos de entrada del banco 0 (se ejecuta en 0x4000).
#
# Cada uno lleva la instruccion que lo justifica. Los que ponen "pNN:XXXX"
# vienen de OTRO banco: el trazador de una sola pagina no puede seguirlos,
# porque en esa direccion -segun lo que haya en el registro del mapper- puede
# estar cualquiera de seis bancos. Los que ponen "tabla" salen de una tabla
# del despachador (cartucho.DESPACHADOR), que va pegada detras de su `call` y esta declarada
# como datos en el .nocode: el trazador tampoco puede seguirla.
#
# Los saltos y llamadas DENTRO del propio banco no se ponen aqui: los
# encuentra tools/z80trace.py solo, siguiendo el flujo.
#
# Este fichero lo regenera `make semillas` (tools/bancos.py escribe).
0x4030   # p10:8D46 call
0x4033   # tabla de saltos de 0x4030 (la entrada 0 la llama p10:8D46): jp 0x4042
0x4036   # tabla de saltos de 0x4030: jp 0x404B
0x4042   # codigo huerfano: 9 bytes que acaban en un salto; el trazado no entra y ninguna instruccion salta, llama o carga 0x4042
0x404B   # codigo huerfano: 9 bytes que acaban en un salto; el trazado no entra y ninguna instruccion salta, llama o carga 0x404B
0x4054   # la apunta la segunda cabecera (palabra de 0x4023, la que lee el Game Master)
0x4069   # gancho de interrupcion H.KEYI: INIT escribe 0xC3 en 0xFD9A y esta direccion en 0xFD9B (p00:40DD-p00:40E7)
0x40C4   # p01:75EA call
0x40C9   # p01:6656 call
0x40CE   # p01:66BE call
0x40CF   # p02:8961 call
0x40DA   # cabecera AB: INIT
0x416B   # codigo huerfano: 3 bytes que acaban en un salto; el trazado no entra y ninguna instruccion salta, llama o carga 0x416B
0x4173   # codigo huerfano: 5 bytes que acaban en un salto; el trazado no entra y ninguna instruccion salta, llama o carga 0x4173
0x4199   # p10:801B jp
0x41AC   # p03:BFEC call
0x41B0   # ld a,10 de las rutinas de banco: cae en p00:41B2; nadie la llama ni la carga
0x41BB   # p01:6743 call
0x41BF   # p10:8031 call
0x41C3   # p01:7BA7 call
0x41CB   # p01:6770 call
0x41D0   # p01:712B jp cc
