# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x4069 interrupcion la interrupcion (H.KEYI): cuenta el cuadro, el sonido con 4-5-6 y el cuadro del juego
L 0x40C4 hl_mas_a HL = HL + A
L 0x40C9 de_mas_a DE = DE + A
L 0x40CE despacha salta a la entrada A de la tabla que va detras del call
L 0x40DA init el arranque del cartucho (INIT de la cabecera AB)
L 0x416E bancos_1_2_3 pone los bancos 1-2-3 (y su copia en 0xF0F1-3)
L 0x4173 bancos_4_5_6 pone los bancos 4-5-6 (y su copia en 0xF0F1-3)
L 0x4178 bancos_7_8_9 pone los bancos 7-8-9 (y su copia en 0xF0F1-3)
L 0x417D bancos_13_14_15 pone los bancos 13-14-15 (y su copia en 0xF0F1-3)
L 0x4199 bancos_10_15 pone el banco 10 en 0x8000 y el 15 en 0xA000 (y su copia en 0xF0F1-3)
L 0x41AC banco_14_en_8000 pone el banco 14 en 0x8000 (y su copia en 0xF0F1-3)
L 0x41B0 banco_10_en_8000 pone el banco 10 en 0x8000 (y su copia en 0xF0F1-3)
L 0x41BB banco_6_en_a000 pone el banco 6 en 0xA000 (y su copia en 0xF0F1-3)
