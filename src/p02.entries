# Puntos de entrada del banco 2 (se ejecuta en 0x8000).
#
# Cada uno lleva la instruccion que lo justifica. Los que ponen "pNN:XXXX"
# vienen de OTRO banco: el trazador de una sola pagina no puede seguirlos,
# porque en esa direccion -segun lo que haya en el registro del mapper- puede
# estar cualquiera de seis bancos. Los que ponen "tabla" salen de una tabla
# del despachador (cartucho.DESPACHADOR), que va pegada detras de su `call` y esta declarada
# como datos en el .nocode: el trazador tampoco puede seguirla.
#
# Los saltos y llamadas DENTRO del propio banco no se ponen aqui: los
# encuentra tools/z80trace.py solo, siguiendo el flujo.
#
# Este fichero lo regenera `make semillas` (tools/bancos.py escribe).
0x8000   # p01:7FFF sigue de largo (el codigo cruza la frontera de banco)
0x8002   # p01:7FE3 jr cc
0x800D   # p01:7FE6 jr cc
0x8025   # p00:50B2 call
0x8031   # p01:6E99 call
0x8077   # p01:66BE entrada 0 de la tabla de 0x66C1 (call 0x40CE en 0x66BE)
0x80E9   # p01:68EE entrada 0 de la tabla de 0x68F1 (call 0x40CE en 0x68EE)
0x81CE   # p03:A361 call
0x81D2   # p12:B1A7 jp
0x81F6   # p01:66BE entrada 37 de la tabla de 0x66C1 (call 0x40CE en 0x66BE)
0x820D   # p01:68EE entrada 37 de la tabla de 0x68F1 (call 0x40CE en 0x68EE)
0x824E   # p01:66BE entrada 40 de la tabla de 0x66C1 (call 0x40CE en 0x66BE)
0x825B   # p01:66BE entrada 41 de la tabla de 0x66C1 (call 0x40CE en 0x66BE)
0x8263   # p00:403C call
0x8510   # p00:421C call
0x8525   # p02:8514 entrada 0 de la tabla de 0x8517 (call 0x40CE en 0x8514)
0x85A5   # p02:8514 entrada 1 de la tabla de 0x8517 (call 0x40CE en 0x8514)
