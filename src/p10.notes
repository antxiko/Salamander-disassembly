# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x8044 ventana_menu pinta la ventana del menu B
L 0x80DC graficos_menu con el 9 en 0xA000, los caracteres y copias del menu B (0xE63A)
L 0x8107 caracteres_menu la lista de caracteres de la entrada B & 0x0F de 0xA4BF
L 0x87F5 borra_c700 borra 0xC700-0xCFFF
L 0x9470 empieza_texto prepara el texto A de la tabla HL para escribirlo letra a letra
L 0x95C1 abre_ventana copia la cabecera de ventana de HL (7 bytes) a 0xEE10
C 0x8021 banco_9_en_a000: pone el banco 9 en 0xA000 (y su copia en 0xF0F1-3)
C 0x806A rachas: descomprime las rachas de DE en la VRAM HL
C 0x8074 palabra_a_hl: HL = la palabra HL + 2 x A
C 0x807F palabra_de_hl: DE = la palabra HL + 2 x A
C 0x80C7 rachas_3: las rachas de DE en la VRAM HL, en los tres tercios
C 0x80D0 rachas_3: las rachas de DE en la VRAM HL, en los tres tercios
C 0x80D9 rachas: descomprime las rachas de DE en la VRAM HL
C 0x80E0 guarda el menu o pantalla de la presentacion (0xE63A & 0x0F)
C 0x80ED lee el menu o pantalla de la presentacion (0xE63A & 0x0F)
C 0x80F2 copias_de_tabla: la lista de copias VRAM -> VRAM de la entrada A de la tabla HL
C 0x80FC lee el menu o pantalla de la presentacion (0xE63A & 0x0F)
C 0x8101 copias_de_tabla: la lista de copias VRAM -> VRAM de la entrada A de la tabla HL
C 0x810C palabra_de_hl: DE = la palabra HL + 2 x A
C 0x8163 hl_mas_a: HL = HL + A
C 0x816D de_mas_a: DE = DE + A
C 0x824F pide_sonido: pide el sonido A con los bancos 4-5-6 (p04:6472) y devuelve los de antes
C 0x825D guarda la cuenta de interrupciones (16 bits)
